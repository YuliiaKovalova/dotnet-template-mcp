<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.TemplateEngine.MCP</RootNamespace>
    <AssemblyName>Microsoft.TemplateEngine.MCP</AssemblyName>
    <Description>MCP (Model Context Protocol) server wrapping the .NET Template Engine for AI-driven template discovery, inspection, and instantiation.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>template-engine-mcp</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-preview.1</Version>
    <Authors>YuliiaKovalova</Authors>
    <PackageProjectUrl>https://github.com/YuliiaKovalova/dotnet-template-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YuliiaKovalova/dotnet-template-mcp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mcp;template-engine;dotnet-new;ai;copilot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
    <PackageReference Include="Microsoft.TemplateEngine.Abstractions" />
    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" />
    <PackageReference Include="Microsoft.TemplateSearch.Common" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.TemplateEngine.MCP.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
