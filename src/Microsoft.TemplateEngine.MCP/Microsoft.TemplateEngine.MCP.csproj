<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.TemplateEngine.MCP</RootNamespace>
    <AssemblyName>Microsoft.TemplateEngine.MCP</AssemblyName>
    <Description>MCP (Model Context Protocol) server wrapping the .NET Template Engine for AI-driven template discovery, inspection, and instantiation.</Description>
    <PackAsTool>true</PackAsTool>
    <PackageId>DotnetTemplateMCP</PackageId>
    <ToolCommandName>template-engine-mcp</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Version>1.1.0</Version>
    <Authors>YuliiaKovalova</Authors>
    <PackageProjectUrl>https://github.com/YuliiaKovalova/dotnet-template-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YuliiaKovalova/dotnet-template-mcp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mcp;template-engine;dotnet-new;ai;copilot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
    <PackageReference Include="Microsoft.TemplateEngine.Abstractions" />
    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" />
    <PackageReference Include="Microsoft.TemplateSearch.Common" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- Use .NET 8 versions of template engine packages when targeting net8.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Update="Microsoft.TemplateEngine.IDE" VersionOverride="8.0.406" />
    <PackageReference Update="Microsoft.TemplateEngine.Abstractions" VersionOverride="8.0.406" />
    <PackageReference Update="Microsoft.TemplateEngine.Edge" VersionOverride="8.0.406" />
    <PackageReference Update="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" VersionOverride="8.0.406" />
    <PackageReference Update="Microsoft.TemplateSearch.Common" VersionOverride="8.0.406" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.TemplateEngine.MCP.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
