<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.TemplateEngine.MCP</RootNamespace>
    <AssemblyName>Microsoft.TemplateEngine.MCP</AssemblyName>
    <Description>MCP (Model Context Protocol) server wrapping the .NET Template Engine for AI-driven template discovery, inspection, and instantiation.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>template-engine-mcp</ToolCommandName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
    <PackageReference Include="Microsoft.TemplateEngine.Abstractions" />
    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" />
    <PackageReference Include="Microsoft.TemplateSearch.Common" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.TemplateEngine.MCP.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
